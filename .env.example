# GEMINI_API_KEY: Wajib untuk pemanggilan Google Gemini API.
# - Di Google AI Studio: otomatis terinjeksi dari panel Secrets.
# - Di Vercel: Atur di Dashboard Vercel > Project Settings > Environment Variables
#   Key: GEMINI_API_KEY
#   Value: [API Key Anda dari https://aistudio.google.com/app/apikey]
GEMINI_API_KEY="AIzaSy..."

# GEMINI_MODEL: (Opsional) Model Gemini default adalah 'gemini-3.8-flash'.
# Jika tidak disetel, sistem otomatis menggunakan 'gemini-3.8-flash' dengan fallback ke 'gemini-flash-latest'.
GEMINI_MODEL="gemini-3.8-flash"

# APP_URL: URL host aplikasi (misal: https://laporan-p2m-bnn.vercel.app)
APP_URL="http://localhost:3000"
